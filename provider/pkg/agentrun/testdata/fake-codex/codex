#!/bin/sh
# A fake Codex CLI (codex exec --json of Codex 0.162) for AgentRun's tests: it never calls a
# model. It checks the arguments AgentRun passes, logs how it was started, does what a real run
# would do to the working directory, and prints a recorded JSONL session. See README.md for the
# modes and the log format.
set -u

here=$(cd "$(dirname "$0")" && pwd -P)
log=${FAKE_CODEX_LOG:-./.fake-codex.log}
pidfile=${FAKE_CODEX_PIDFILE:-./.fake-codex.pid}
mode=${FAKE_CODEX_MODE:-ok}

# flag prints whether a variable is set to a non-empty value, never the value.
flag() {
	eval "v=\${$1:-}"
	if [ -n "$v" ]; then echo set; else echo unset; fi
}

# violation reports arguments that break AgentRun's contract with Codex.
violation() {
	echo "fake codex: $*" >&2
	exit 2
}

# The PWD the CLI was started with: a shell resets PWD when it does not name the working
# directory, so read the original environment where the system has it.
pwd_env=${PWD:-}
if [ -r "/proc/$$/environ" ]; then
	pwd_env=$(tr '\0' '\n' <"/proc/$$/environ" | sed -n 's/^PWD=//p' | head -n 1)
fi

# logstart starts a log entry with the kind of invocation and its arguments.
logstart() {
	kind=$1
	shift
	{
		echo "--- invocation"
		echo "kind=$kind"
		echo "argc=$#"
		for a in "$@"; do echo "arg=$a"; done
		echo "cwd=$(pwd)"
		echo "pid=$$"
	} >>"$log"
}

case "${1:-}" in
--version)
	logstart version "$@"
	if [ -n "${FAKE_CODEX_VERSION_FAIL:-}" ]; then
		echo "error: the version is not known" >&2
		exit 1
	fi
	echo "codex-cli ${FAKE_CODEX_VERSION:-0.162.1}"
	exit 0
	;;
--config=*)
	# The sandbox check: codex --config=sandbox_mode="workspace-write" sandbox -- true.
	logstart sandbox "$@"
	[ "$1" = '--config=sandbox_mode="workspace-write"' ] || violation "sandbox check: unexpected $1"
	[ $# -eq 4 ] && [ "$2" = sandbox ] && [ "$3" = -- ] && [ "$4" = true ] || violation "sandbox check: unexpected arguments"
	case "${FAKE_CODEX_SANDBOX:-ok}" in
	ok)
		exit 0
		;;
	unavailable)
		echo "bwrap: No permissions to create a new namespace, likely because the kernel does not allow non-privileged user namespaces. On e.g. debian this can be enabled with 'sysctl kernel.unprivileged_userns_clone=1'." >&2
		exit 1
		;;
	missing)
		echo "error: unrecognized subcommand 'sandbox'" >&2
		exit 2
		;;
	broken)
		echo "Error loading config.toml: unknown variant \`full-auto\`, expected one of \`read-only\`, \`workspace-write\`" >&2
		exit 1
		;;
	hang)
		sleep 300 &
		echo $! >"$pidfile"
		wait $!
		exit 1
		;;
	esac
	violation "unknown FAKE_CODEX_SANDBOX"
	;;
exec)
	logstart exec "$@"
	shift
	;;
*)
	violation "unexpected arguments: $*"
	;;
esac

json='' color='' skipgit='' sandbox='' approval='' bypass='' model='' schema='' last='' resume='' dash=''
while [ $# -gt 0 ]; do
	case "$1" in
	--json) json=1 ;;
	--color=never) color=1 ;;
	--skip-git-repo-check) skipgit=1 ;;
	--sandbox=workspace-write) sandbox=1 ;;
	'--config=approval_policy="never"') approval=1 ;;
	--dangerously-bypass-approvals-and-sandbox) bypass=1 ;;
	--model=*) model=${1#--model=} ;;
	--output-schema=*) schema=${1#--output-schema=} ;;
	--output-last-message=*) last=${1#--output-last-message=} ;;
	resume)
		# Flags must come before resume, which accepts fewer of them.
		[ $# -eq 3 ] && [ "$3" = - ] || violation "resume must be followed by a thread ID and - only"
		resume=$2
		shift
		;;
	-)
		[ $# -eq 1 ] || violation "- is not the last argument"
		dash=1
		;;
	-*)
		echo "error: unexpected argument '$1' found" >&2
		exit 2
		;;
	*) violation "unexpected positional argument (a prompt in argv?)" ;;
	esac
	shift
done
[ -n "$json" ] || violation "--json is missing"
[ -n "$color" ] || violation "--color=never is missing"
[ -n "$skipgit" ] || violation "--skip-git-repo-check is missing"
[ -n "$dash" ] || violation "the prompt is not read from stdin (no -)"
[ -n "$last" ] || violation "--output-last-message is missing"
if [ -n "$bypass" ]; then
	[ -z "$sandbox$approval" ] || violation "--dangerously-bypass-approvals-and-sandbox together with a sandbox"
	sandbox_mode=off
else
	[ -n "$sandbox" ] && [ -n "$approval" ] ||
		violation "neither --dangerously-bypass-approvals-and-sandbox nor --sandbox=workspace-write with approval_policy never"
	sandbox_mode=workspace-write
fi

prompt=$(cat)
# With FAKE_CODEX_IGNORE_TERM, the fake and every process it starts ignore SIGTERM.
if [ -n "${FAKE_CODEX_IGNORE_TERM:-}" ]; then
	trap '' TERM
fi

case "$prompt" in
'') ;;
Delete*)
	if [ -f .fail-delete ]; then
		mode=failed-auth
	else
		rm -f NOTES.md
		mode=ok
	fi
	;;
*)
	printf '%s\n' "$prompt" >NOTES.md
	;;
esac

{
	echo "realcwd=$(pwd -P)"
	echo "pwd_env=$pwd_env"
	echo "home=${HOME:-}"
	echo "codex_home=${CODEX_HOME:-}"
	echo "mode=$mode"
	echo "sandbox=$sandbox_mode"
	echo "model=$model"
	echo "resume=$resume"
	echo "output_schema=$schema"
	if [ -n "$schema" ] && [ -f "$schema" ]; then echo "schema=$(tr -d '\n' <"$schema")"; fi
	echo "last_message=$last"
	echo "codex_api_key=$(flag CODEX_API_KEY)"
	echo "codex_access_token=$(flag CODEX_ACCESS_TOKEN)"
	echo "openai_api_key=$(flag OPENAI_API_KEY)"
	echo "codex_thread_id=$(flag CODEX_THREAD_ID)"
	echo "codex_sandbox=$(flag CODEX_SANDBOX)"
	echo "rust_log=${RUST_LOG:-}"
	echo "https_proxy=${HTTPS_PROXY:-}"
	echo "marker=${FAKE_MARKER:-}"
	echo "cookie=$(flag DOCKER_AGENT_RUN_COOKIE)"
	echo "agentrun_cookie=$(flag DOCKER_AGENT_AGENTRUN_COOKIE)"
	echo "stdin=$prompt"
} >>"$log"

if [ -z "$prompt" ]; then
	echo "No prompt provided via stdin." >&2
	exit 1
fi
if [ -n "${CODEX_HOME:-}" ] && [ ! -d "$CODEX_HOME" ]; then
	echo "Error finding codex home: CODEX_HOME points to \"$CODEX_HOME\", but that path does not exist" >&2
	exit 1
fi
# forced_login_method: Codex logs out (it removes auth.json) and exits when the credential it
# would use is of the other kind.
codex_home=${CODEX_HOME:-${HOME:-}/.codex}
if [ -f "$codex_home/config.toml" ] && grep -q '^forced_login_method *= *"chatgpt"' "$codex_home/config.toml" &&
	[ -n "${CODEX_API_KEY:-}" ]; then
	rm -f "$codex_home/auth.json"
	echo "Error: ChatGPT login is required, but an API key is currently being used. Logging out." >&2
	exit 1
fi

if [ -n "${FAKE_CODEX_STDERR:-}" ]; then
	printf '%s\n' "$FAKE_CODEX_STDERR" >&2
fi

thread=${resume:-0199a213-81c0-7800-8aa1-bbab2a035a53}
# A resumed thread continues with the thread's running usage total.
if [ -n "$resume" ] && [ "$mode" = ok ]; then
	mode=resume
fi
realcwd=$(pwd -P)

# esc escapes a value for a sed replacement.
esc() { printf '%s' "$1" | sed 's/[\\&|]/\\&/g'; }

# emit prints a fixture with its placeholders replaced: the thread ID, the working directory
# and FAKE_CODEX_PRINT (__TOKEN__).
emit() {
	sed -e "s|__THREAD__|$(esc "$thread")|g" -e "s|__CWD__|$(esc "$realcwd")|g" \
		-e "s|__TOKEN__|$(esc "${FAKE_CODEX_PRINT:-}")|g" "$here/$1"
}

# session prints a fixture of a completed turn and writes its final message to the
# --output-last-message file, as Codex does (unless FAKE_CODEX_NO_LAST is set).
session() {
	emit "$1"
	f="$here/${1%.jsonl}.last"
	if [ -f "$f" ] && [ -z "${FAKE_CODEX_NO_LAST:-}" ]; then
		sed -e "s|__TOKEN__|$(esc "${FAKE_CODEX_PRINT:-}")|g" "$f" >"$last"
	fi
}

# init prints the start of a session: thread.started and turn.started.
init() { emit session.jsonl | head -n 2; }

# insession runs a command in a session of its own, as Codex starts shell commands. It
# replaces the shell it runs in, so that `insession ... &` sets $! to the command's PID.
insession() {
	if command -v setsid >/dev/null 2>&1; then
		exec setsid "$@"
	else
		exec perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$@"
	fi
}

# detached starts `sleep 300` in a session of its own and sets child to its PID.
detached() {
	insession sleep 300 >/dev/null 2>&1 </dev/null &
	child=$!
}

# The code of insession, for the shells the fake starts.
insession_sh='if command -v setsid >/dev/null 2>&1; then exec setsid "$@"; else exec perl -MPOSIX -e "POSIX::setsid(); exec @ARGV" "$@"; fi'

# shellcmd starts a shell in a session of its own that runs `sleep 300` as its child and waits
# for it, as Codex runs a command. The shell appends its PID and then the sleep's to the
# pidfile. On SIGTERM it appends its PID to <pidfile>.term, takes 0.3 s to stop and then
# appends its PID to <pidfile>.stopped. shellcmd sets shell to the shell's PID.
shellcmd() {
	insession sh -c 'trap "echo \$\$ >>\"\$1.term\"; sleep 0.3; echo \$\$ >>\"\$1.stopped\"; exit 143" TERM
		sleep 300 & s=$!
		{ echo "$$"; echo "$s"; } >>"$1"
		wait "$s"' sh "$pidfile" >/dev/null 2>&1 </dev/null &
	shell=$!
}

# lines prints the number of lines of the pidfile.
lines() {
	if [ -f "$pidfile" ]; then echo $(($(wc -l <"$pidfile"))); else echo 0; fi
}
base=$(lines)

# pids waits until this invocation added $1 lines to the pidfile.
pids() {
	while [ "$(lines)" -lt $((base + $1)) ]; do sleep 0.05; done
}

case "$mode" in
ok)
	session session.jsonl
	;;
json | schema | token | declined | tool-failed | item-error | retry | not-json | sandbox-denied | lagged | collab | resume)
	session "session-$mode.jsonl"
	;;
rotate)
	# As Codex refreshing a ChatGPT login during the turn: it rewrites auth.json with a new
	# access token (FAKE_CODEX_ROTATED), which a command then prints, and so does the answer.
	printf '{"auth_mode":"chatgpt","OPENAI_API_KEY":null,"tokens":{"id_token":"a.b.c","access_token":"%s","refresh_token":"rt-rotated-refresh-0123456789"}}\n' \
		"${FAKE_CODEX_ROTATED:-}" >"$codex_home/auth.json"
	FAKE_CODEX_PRINT=${FAKE_CODEX_ROTATED:-}
	session session-token.jsonl
	;;
failed-auth | refresh-reused | usage-limit | not-included | quota | unknown-model)
	# Codex exits 1 when the turn failed.
	emit "session-$mode.jsonl"
	exit 1
	;;
no-message)
	emit session-no-message.jsonl
	;;
incomplete)
	emit session-incomplete.jsonl
	;;
exit-after-complete)
	session session.jsonl
	echo "error: the turn ended with an error notification" >&2
	exit 1
	;;
cli-args)
	echo "error: unexpected argument '--output-last-message' found" >&2
	exit 2
	;;
mcp-failed)
	init
	echo "Error: required MCP server \`docs\` failed to initialize: program not found" >&2
	exit 1
	;;
hang)
	# Ignores SIGTERM (and so does its child) and logs SIGINT, so only the SIGKILL after the
	# grace period stops the group.
	trap '' TERM
	trap 'echo int >>"$log"' INT
	init
	sleep 300 &
	s=$!
	echo "$s" >"$pidfile"
	while kill -0 "$s" 2>/dev/null; do wait "$s"; done
	;;
interrupt)
	# As Codex: SIGINT interrupts the turn, which ends the commands Codex started, and exits 1
	# without a terminal event. The pidfile gets the detached command's PID once the trap is set.
	init
	detached
	trap 'echo int >>"$log"; kill "$child" 2>/dev/null; exit 1' INT
	trap 'echo term >>"$log"; exit 143' TERM
	echo "$child" >"$pidfile"
	sleep 300 &
	s=$!
	while kill -0 "$s" 2>/dev/null; do wait "$s"; done
	;;
term-trap)
	# Logs SIGINT and carries on; stops on SIGTERM, after 0.3 s, ending the detached command.
	init
	detached
	sleep 300 &
	sleeper=$!
	trap 'echo int >>"$log"' INT
	trap 'echo term >>"$log"; sleep 0.3; kill "$child" "$sleeper" 2>/dev/null; exit 143' TERM
	echo "$child" >"$pidfile"
	while kill -0 "$sleeper" 2>/dev/null; do wait "$sleeper"; done
	;;
hang-detached)
	# Ends on SIGINT at once (no trap), leaving a command in a session of its own and one in its
	# group running.
	init
	detached
	echo "$child" >"$pidfile"
	sleep 300
	;;
leftover)
	sleep 300 >/dev/null 2>&1 </dev/null &
	echo $! >"$pidfile"
	session session.jsonl
	;;
background-session)
	# A command that Codex ran in the background and left running when it exited: the CLI
	# works for 1 s more (the runner reads the process table every 0.2 s), then exits 0.
	shellcmd
	pids 2
	sleep 1
	session session.jsonl
	;;
oneshot)
	# Three times, 0.1 s apart: a shell in a session of its own runs `sleep 300 &` and exits at
	# once, so the sleep's parent is gone before a poll can see it; the sleeps still have the
	# run's cookie. The CLI exits 0.5 s later.
	for i in 1 2 3; do
		insession sh -c 'sleep 300 >/dev/null 2>&1 </dev/null & echo "$!" >>"$1"' sh "$pidfile" \
			>/dev/null 2>&1 </dev/null &
		sleep 0.1
	done
	pids 3
	sleep 0.5
	session session.jsonl
	;;
mcp-group)
	# A stdio MCP server as Codex starts one: a direct child in a process group of its own in
	# the CLI's session, which takes 0.3 s to stop on SIGTERM. Its PID goes to the pidfile. The
	# CLI exits 0.5 s later.
	perl -e 'setpgrp(0, 0); exec @ARGV' sh -c 'trap "sleep 0.3; exit 0" TERM; echo $$ >>"$1"; sleep 300 & wait $!' \
		sh "$pidfile" >/dev/null 2>&1 </dev/null &
	pids 1
	sleep 0.5
	session session.jsonl
	;;
*)
	echo "fake codex: unknown FAKE_CODEX_MODE $mode" >&2
	exit 2
	;;
esac
